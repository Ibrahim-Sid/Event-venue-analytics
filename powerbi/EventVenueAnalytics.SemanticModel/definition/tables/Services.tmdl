	partition Services = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataPath & "services.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"service_id", Int64.Type}, {"name", type text}, {"unit", type text}, {"unit_price_eur", type number}, {"unit_cost_eur", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
