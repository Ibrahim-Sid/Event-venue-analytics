	partition Rooms = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataPath & "rooms.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"room_id", Int64.Type}, {"room_name", type text}, {"capacity", Int64.Type}, {"daily_rate_eur", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
